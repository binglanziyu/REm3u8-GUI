# =====================================================================
#  REM-GUI .gitignore
#  原则：只入库"源码 / 脚本 / 文档 / update.json"；
#       交付二进制（REM-GUI.exe / N_m3u8DL-RE.exe / ffmpeg.exe）不入库，
#       只在 GitHub Releases 分发，克隆仓库后按 README 放入 dist\ 再构建。
# =====================================================================

# ---------- 运行日志（含 HLS 密钥等敏感信息，绝不入库） ----------
logs/
dist/logs/
*.log
*.log.*

# ---------- 备份 / 断点续传残留 ----------
*.bak
*.bak?
*.resume.json
*.tmp

# ---------- 端到端测试产物 ----------
e2e_out/
dist/e2e_out/
smoke_out/
_out/

# ---------- 调试截图 / 探针临时产物（tools\*.ps1 的默认输出均落 %TEMP%，此处兜底） ----------
shot*.png
shot_*.png
dist/shot*.png
*.probe.exe
probe*.exe
_probe/
probe_out/

# ---------- 编译中间目录 ----------
bin/
obj/
[Bb]in/
[Oo]bj/

# ---------- 调试符号 ----------
*.pdb

# ---------- 临时编译检查产物（build_csharp.ps1 若残留的 *.dll） ----------
*.dll
*.dll.config

# ---------- 系统垃圾 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 编辑器 / IDE 本地状态 ----------
.vs/
*.user
*.suo
.idea/
.vscode/

# ---------- 交付二进制：不入库，只随 Releases 发 REM-GUI.exe ----------
#  仓库体积与授权考量：引擎 N_m3u8DL-RE.exe(0.6.0) 与 ffmpeg.exe 由使用者自备，
#  REM-GUI.exe 只作为 Release 资产发布，不进入版本库。
dist/*.exe
!dist/.gitkeep

# dist/update.json 已废弃：清单模板固定在 REM-GUI-src/update.json 并内嵌进 exe，
# 构建不再往 dist 下发；本地调试若手动放了覆盖文件，也不该跟进仓库。
dist/update.json

# =====================================================================
#  以下为强制保留项（源码与清单模板不得被任何规则顺手忽略）
#  清单唯一模板是 REM-GUI-src/update.json，dist 下不再有交付文件依赖
# =====================================================================
!*.cs
!REM-GUI-src/update.json

# ---------- 探针/验证残留（本地跑 e2e 产生，不入库）----------
REM-GUI-src/temp/
temp/
